{
  "name": "ai-platform-agents",
  "version": "0.1.0",
  "private": true,
  "description": "AI Platform delivery framework: Copilot agents, skills, prompts and guard hooks for Plan > Design > Build > Review > Release > Docs.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-include=scripts/** --test-coverage-include=.github/** --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "validate": "node scripts/validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "license": "OGL-UK-3.0"
}
